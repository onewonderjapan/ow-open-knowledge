# https://editorconfig.org
# Japanese and Chinese documents in this repo are edited from Windows, macOS and Linux.
# Normalising line endings and trailing whitespace keeps diffs readable.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 100

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[Makefile]
indent_style = tab
