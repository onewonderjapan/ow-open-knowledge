# Runtime output (generated per run)
output/
workspace/
# Ignore requirement files' contents but keep the committed example so newcomers
# have something to copy. `requirements/` (directory form) would stop git from
# descending at all, and the negation below could never take effect.
requirements/*
!requirements/example.md

# Agent memory & evolved prompts (machine-specific)
agents/memory/*.md
agents/prompts/*.md

# Python
__pycache__/
*.pyc
*.pyo

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Claude Code
.claude/
